# LLMO Analyzer Configuration
# Copy this file to .env and fill in your values

# Required: Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Model selection (defaults to llama-3.3-70b-versatile)
# Available models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Request timeout in seconds
REQUEST_TIMEOUT=30

# Optional: Maximum content length to analyze (in characters)
MAX_CONTENT_LENGTH=10000
